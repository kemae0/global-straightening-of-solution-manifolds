GlobalRegularization.sumPaperBernstein_strong.{u_1} (B : Type u_1) [NormedAddCommGroup B] [NormedSpace ℝ B]
  [CompleteSpace B] (x : GlobalRegularization.SumC1History 1 B) :
  Filter.Tendsto (fun m => (GlobalRegularization.sumPaperBernstein B m) x) Filter.atTop (nhds x)
GlobalRegularization.sumPaperBernstein_continuous_operator_limit.{u_1} (B : Type u_1) [NormedAddCommGroup B]
  [NormedSpace ℝ B] [CompleteSpace B] :
  Filter.Tendsto
    (fun m =>
      (GlobalRegularization.sumHistoryInclusion 1 B).comp (GlobalRegularization.sumPaperBernstein B m) -
        GlobalRegularization.sumHistoryInclusion 1 B)
    Filter.atTop (nhds 0)
GlobalRegularization.sumPaperBernstein_nested.{u_1} (B : Type u_1) [NormedAddCommGroup B] [NormedSpace ℝ B]
  [CompleteSpace B] (i j : ℕ) (hij : i ≤ j) (x y : GlobalRegularization.SumC1History 1 B)
  (hxy : (GlobalRegularization.sumPaperBernstein B j) x = (GlobalRegularization.sumPaperBernstein B j) y) :
  (GlobalRegularization.sumPaperBernstein B i) x = (GlobalRegularization.sumPaperBernstein B i) y
GlobalRegularization.LocalC1Approximation.literal_sup_bound.{u_1, u_2} {E : Type u_1} {B : Type u_2}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup B] [NormedSpace ℝ B] {U : Set E} {f : E → B}
  {fm : ℕ → E → B} (happ : GlobalRegularization.LocalC1Approximation U f fm) {x : E} (hx : x ∈ U) (η : ℝ) (hη : 0 < η) :
  ∃ r > 0,
    Metric.ball x r ⊆ U ∧
      ∃ N,
        sSup
            ((fun p => ‖fm p.1 p.2 - f p.2‖ + ‖fderiv ℝ (fm p.1) p.2 - fderiv ℝ f p.2‖) ''
              {p | N ≤ p.1 ∧ p.2 ∈ Metric.ball x r}) <
          η
