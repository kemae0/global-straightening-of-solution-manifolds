GlobalRegularization.property_e_revised_main (h : NNReal) (hh : 0 < ↑h) (n : ℕ) [NeZero n]
  (U : Set (GlobalRegularization.C1History h (Fin n → ℝ))) (hU : IsOpen U)
  (f : GlobalRegularization.C1History h (Fin n → ℝ) → Fin n → ℝ)
  (he : GlobalRegularization.HasExtendedDerivative U (GlobalRegularization.historyInclusion h (Fin n → ℝ)) f) (τ ε : ℝ)
  (hτ : 0 < τ) (hε : 0 < ε) :
  ∃ chart,
    GlobalRegularization.LocalizedHistoryStraightening.HasLocalizedAffineIsotopy h (Fin n → ℝ) chart ∧
      (∀ x ∈ U, spectrum ℂ (GlobalRegularization.RealComplexification.map (fderiv ℝ chart.forward x)) = {1}) ∧
        (∃ c ∈ Set.Ioo 0 ε,
            ∀ s ∈ Set.Icc 0 1,
              ∀ x ∈ U,
                ‖(GlobalRegularization.historyInclusion h (Fin n → ℝ))
                      (GlobalRegularization.affineHomotopy chart.forward s x - x)‖ ≤
                  c) ∧
          chart.forward ''
              GlobalRegularization.solutionManifold U (⇑(GlobalRegularization.endpointDerivative h (Fin n → ℝ))) f =
            chart.target ∩ GlobalRegularization.zeroHyperplane ⇑(GlobalRegularization.endpointDerivative h (Fin n → ℝ))
GlobalRegularization.LocalizedHistoryStraightening.positive_uniform_affine_bound.{u_1} (h : NNReal) (B : Type u_1)
  [NormedAddCommGroup B] [NormedSpace ℝ B] [CompleteSpace B] {U : Set (GlobalRegularization.C1History h B)}
  {f : GlobalRegularization.C1History h B → B} {τ ε : ℝ}
  (chart : GlobalRegularization.LocalizedHistoryStraightening h B U f τ ε) (hε : 0 < ε) :
  ∃ c ∈ Set.Ioo 0 ε,
    ∀ s ∈ Set.Icc 0 1,
      ∀ x ∈ U,
        ‖(GlobalRegularization.historyInclusion h B) (GlobalRegularization.affineHomotopy chart.forward s x - x)‖ ≤ c
