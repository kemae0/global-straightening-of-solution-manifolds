GlobalRegularization.terminal_atom_endpoint_coupling (h : NNReal) (hh : 0 < ↑h) (n : ℕ)
  (U : Set (GlobalRegularization.C1History h (Fin n → ℝ))) (hU : IsOpen U)
  (g : GlobalRegularization.C1History h (Fin n → ℝ) → Fin n → ℝ) (hg : ContDiffOn ℝ 1 g U)
  (hzero : GlobalRegularization.HasVanishingTerminalDerivative h (Fin n → ℝ) U g) (M : (Fin n → ℝ) →L[ℝ] Fin n → ℝ)
