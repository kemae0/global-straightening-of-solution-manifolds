GlobalRegularization.property_e_solution_manifold.{u_1} (h : NNReal) (B : Type u_1) [NormedAddCommGroup B]
  [NormedSpace ℝ B] [CompleteSpace B] [FiniteDimensional ℝ B] (hh : 0 < ↑h)
  (U : Set (GlobalRegularization.C1History h B)) (hU : IsOpen U) (f : GlobalRegularization.C1History h B → B)
  (he : GlobalRegularization.HasExtendedDerivative U (GlobalRegularization.historyInclusion h B) f) (τ ε : ℝ)
  (hτ : 0 < τ) (hε : 0 < ε) :
  ∃ chart,
    chart.forward '' GlobalRegularization.solutionManifold U (⇑(GlobalRegularization.endpointDerivative h B)) f =
      chart.forward '' U ∩ GlobalRegularization.zeroHyperplane ⇑(GlobalRegularization.endpointDerivative h B)
GlobalRegularization.terminal_atom_full_straightening (h : NNReal) (hh : 0 < ↑h) (n : ℕ) [NeZero n]
  (U : Set (GlobalRegularization.C1History h (Fin n → ℝ))) (hU : IsOpen U)
  (f : GlobalRegularization.C1History h (Fin n → ℝ) → Fin n → ℝ) (hf : ContDiffOn ℝ 1 f U)
  (hzero : GlobalRegularization.HasVanishingTerminalDerivative h (Fin n → ℝ) U f) (τ ε : ℝ) (hτ : 0 < τ) (hε : 0 < ε) :
