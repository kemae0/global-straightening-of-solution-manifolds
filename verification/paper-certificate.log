GlobalRegularization.historyFunctional_signed_matrix_representation (h : NNReal) (n : ℕ)
  (L : GlobalRegularization.C1History h (Fin n → ℝ) →L[ℝ] Fin n → ℝ) (x : GlobalRegularization.C1History h (Fin n → ℝ))
  (i : Fin n) :
  L x i =
    (GlobalRegularization.historyEndpointPart h n L)
        (((GlobalRegularization.historyInclusion h (Fin n → ℝ)) x) (GlobalRegularization.historyLeft h)) i +
      ∑ j,
        (GlobalRegularization.signedIntegralFunctional (GlobalRegularization.historySignedMatrix h n L i j))
          ((GlobalRegularization.continuousVectorComponent n j)
            ((GlobalRegularization.historyDerivative h (Fin n → ℝ)) x))
