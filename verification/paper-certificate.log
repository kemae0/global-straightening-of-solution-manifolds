GlobalRegularization.RealComplexification.decomposition.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  (f : GlobalRegularization.RealComplexification E) :
  f =
    GlobalRegularization.RealComplexification.embed ((fun z => ↑f z) 1) +
      Complex.I • GlobalRegularization.RealComplexification.embed (-(fun z => ↑f z) Complex.I)
GlobalRegularization.RealComplexification.map_unique.{u_1, u_2} {E : Type u_1} {F : Type u_2} [NormedAddCommGroup E]
  [NormedSpace ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F] (L : E →L[ℝ] F)
  (T : GlobalRegularization.RealComplexification E →L[ℂ] GlobalRegularization.RealComplexification F)
  (hT :
    ∀ (x : E),
      T (GlobalRegularization.RealComplexification.embed x) = GlobalRegularization.RealComplexification.embed (L x)) :
  T = GlobalRegularization.RealComplexification.map L
