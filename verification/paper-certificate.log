  (hzero :
    ∀ L ∈ S,
      Filter.Tendsto
        (fun m =>
          L.comp
            (GlobalRegularization.terminalCorrection h (Fin n → ℝ) (GlobalRegularization.adaptedTerminalWidth h m) ⋯))
