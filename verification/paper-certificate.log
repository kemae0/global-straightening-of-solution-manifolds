  ∃ χ, ContDiff ℝ 1 χ ∧ tsupport χ ⊆ U ∧ (∀ᶠ (x : H) in nhdsSet K, χ x = 1) ∧ ∀ (x : H), χ x ∈ Set.Icc 0 1
GlobalRegularization.property_e_Hilbert_bounded_C1_approximants.{u_1} (H : Type u_1) [NormedAddCommGroup H]
  [InnerProductSpace ℝ H] [CompleteSpace H] [TopologicalSpace.SeparableSpace H]
  (U : Set (GlobalRegularization.C1History 1 H)) (hU : IsOpen U) (f : GlobalRegularization.C1History 1 H → H)
  (he : GlobalRegularization.HasExtendedDerivative U (GlobalRegularization.historyInclusion 1 H) f) :
  ∃ fm,
    (∀ (n : ℕ), ContDiff ℝ 1 (fm n)) ∧
      (∀ (n : ℕ), Bornology.IsBounded (Set.range (fm n))) ∧
        GlobalRegularization.LocalC1Approximation U f fm ∧
          ∀ (i : ℕ) (x y : GlobalRegularization.C1History 1 H),
            (GlobalRegularization.hilbertHistoryObservation H i) x =
                (GlobalRegularization.hilbertHistoryObservation H i) y →
              fm i x = fm i y
