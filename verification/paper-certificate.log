GlobalRegularization.terminal_atom_all_levels (h : NNReal) (hh : 0 < ↑h) (n : ℕ)
  (U : Set (GlobalRegularization.C1History h (Fin n → ℝ))) (hU : IsOpen U)
  (f : GlobalRegularization.C1History h (Fin n → ℝ) → Fin n → ℝ) (hf : ContDiffOn ℝ 1 f U)
  (hzero : GlobalRegularization.HasVanishingTerminalDerivative h (Fin n → ℝ) U f) (τ ε : ℝ) (hτ : 0 < τ) (hε : 0 < ε) :
  ∃ chart,
    ∀ (b : Fin n → ℝ),
      chart.forward '' {x | x ∈ U ∧ (GlobalRegularization.endpointDerivative h (Fin n → ℝ)) x - f x = b} =
        chart.forward '' U ∩ {y | (GlobalRegularization.endpointDerivative h (Fin n → ℝ)) y = b}
GlobalRegularization.terminal_atom_fiber_geometry (h : NNReal) (hh : 0 < ↑h) (n : ℕ)
  (U : Set (GlobalRegularization.C1History h (Fin n → ℝ))) (hU : IsOpen U)
  (f : GlobalRegularization.C1History h (Fin n → ℝ) → Fin n → ℝ) (hf : ContDiffOn ℝ 1 f U)
  (hzero : GlobalRegularization.HasVanishingTerminalDerivative h (Fin n → ℝ) U f) (τ ε : ℝ) (hτ : 0 < τ) (hε : 0 < ε) :
  ∃ chart,
    (∀ (b : Fin n → ℝ),
        chart.forward '' {x | x ∈ U ∧ (GlobalRegularization.endpointDerivative h (Fin n → ℝ)) x - f x = b} =
          chart.forward '' U ∩ {y | (GlobalRegularization.endpointDerivative h (Fin n → ℝ)) y = b}) ∧
      (∀ (b : Fin n → ℝ),
          Nonempty
            (GlobalRegularization.SplitC1FiberParametrization U (GlobalRegularization.endpointDerivative h (Fin n → ℝ))
              f b)) ∧
        ∃ R,
          ContinuousOn R U ∧
            ∀ x ∈ U,
              IsCompl
                  (LinearMap.ker
                    (fderiv ℝ (fun y => (GlobalRegularization.endpointDerivative h (Fin n → ℝ)) y - f y) x))
                  (LinearMap.range (R x)) ∧
                Module.finrank ℝ ↥(LinearMap.range (R x)) = n ∧
                  Module.finrank ℝ
                      (GlobalRegularization.C1History h (Fin n → ℝ) ⧸
                        LinearMap.ker
                          (fderiv ℝ (fun y => (GlobalRegularization.endpointDerivative h (Fin n → ℝ)) y - f y) x)) =
                    n
