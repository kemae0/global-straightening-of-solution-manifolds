  ∃ ν,
    MeasureTheory.IsFiniteMeasure ν ∧
      ν {GlobalRegularization.historyRight h} = 0 ∧
        (∀ (V : Set ↑(GlobalRegularization.HistoryInterval h)), IsOpen V → V.Nonempty → 0 < ν V) ∧
          ∀ L ∈ S,
            ∀ (i j : Fin n), (GlobalRegularization.historySignedMatrix h n L i j).totalVariation.AbsolutelyContinuous ν
GlobalRegularization.finiteMarkov_adjoint_density.{u_1, u_2} {X : Type u_1} [MetricSpace X] [CompactSpace X]
  [MeasurableSpace X] [BorelSpace X] [Nonempty X] {ι : Type u_2} [Fintype ι] (ν : MeasureTheory.Measure X)
  [MeasureTheory.IsFiniteMeasure ν] (ψ : ι → C(X, ℝ)) (hψ : ∀ (j : ι) (x : X), 0 ≤ (ψ j) x)
  (hsum : ∀ (x : X), ∑ j, (ψ j) x = 1) (w : X → ℝ) (hw : MeasureTheory.Integrable w ν) :
  GlobalRegularization.signedMeasureAdjoint (GlobalRegularization.finiteMarkovOperator ℝ ν ψ hψ hsum)
      (GlobalRegularization.signedRieszMeasure (GlobalRegularization.integralDensityFunctional ν w hw)) =
    GlobalRegularization.signedRieszMeasure
      (GlobalRegularization.integralDensityFunctional ν ⇑(GlobalRegularization.finiteMarkovDensity ν ψ w) ⋯)
GlobalRegularization.markovApproximation_signed_totalVariation.{u_1} {X : Type u_1} [MetricSpace X] [CompactSpace X]
