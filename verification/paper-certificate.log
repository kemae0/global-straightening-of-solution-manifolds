  (hfactor : ∀ (i : ℕ) (x y : GlobalRegularization.C1History h B), (O i) x = (O i) y → fm i x = fm i y)
  (hsep : ∀ (x y : GlobalRegularization.C1History h B), (∀ (j : ℕ), (O j) x = (O j) y) → x = y) (σ : ℕ → ℝ)
