GlobalRegularization.historyFunctional_matrix_representation (h : NNReal) (n : ℕ)
  (L : GlobalRegularization.C1History h (Fin n → ℝ) →L[ℝ] Fin n → ℝ) :
  ∃ A μ ν,
    (∀ (i j : Fin n), MeasureTheory.IsFiniteMeasure (μ i j)) ∧
      (∀ (i j : Fin n), MeasureTheory.IsFiniteMeasure (ν i j)) ∧
        ∀ (x : GlobalRegularization.C1History h (Fin n → ℝ)) (i : Fin n),
          L x i =
            A (((GlobalRegularization.historyInclusion h (Fin n → ℝ)) x) (GlobalRegularization.historyLeft h)) i +
              ∑ j,
                (∫ (t : ↑(GlobalRegularization.HistoryInterval h)),
                    ((GlobalRegularization.historyDerivative h (Fin n → ℝ)) x) t j ∂μ i j -
                  ∫ (t : ↑(GlobalRegularization.HistoryInterval h)),
                    ((GlobalRegularization.historyDerivative h (Fin n → ℝ)) x) t j ∂ν i j)
GlobalRegularization.matrixHistoryFunctional_terminal_operator_limit (h : NNReal) (hh : 0 < ↑h) (n : ℕ)
  (L : GlobalRegularization.C1History h (Fin n → ℝ) →L[ℝ] Fin n → ℝ) (A : (Fin n → ℝ) →L[ℝ] Fin n → ℝ)
  (μ ν : Fin n → Fin n → MeasureTheory.Measure ↑(GlobalRegularization.HistoryInterval h))
  [∀ (i j : Fin n), MeasureTheory.IsFiniteMeasure (μ i j)] [∀ (i j : Fin n), MeasureTheory.IsFiniteMeasure (ν i j)]
  (hrep :
    ∀ (x : GlobalRegularization.C1History h (Fin n → ℝ)) (i : Fin n),
      L x i =
        A (((GlobalRegularization.historyInclusion h (Fin n → ℝ)) x) (GlobalRegularization.historyLeft h)) i +
          ∑ j,
            (∫ (t : ↑(GlobalRegularization.HistoryInterval h)),
                ((GlobalRegularization.historyDerivative h (Fin n → ℝ)) x) t j ∂μ i j -
              ∫ (t : ↑(GlobalRegularization.HistoryInterval h)),
                ((GlobalRegularization.historyDerivative h (Fin n → ℝ)) x) t j ∂ν i j))
  (δ : ℕ → ℝ) (hδ : ∀ (m : ℕ), 0 < δ m) (hlim : Filter.Tendsto δ Filter.atTop (nhds 0)) :
  Filter.Tendsto (fun m => L.comp (GlobalRegularization.terminalCorrection h (Fin n → ℝ) (δ m) ⋯)) Filter.atTop
    (nhds (GlobalRegularization.historyAtomOperator h n μ ν))
GlobalRegularization.matrixHistoryFunctional_terminal_zero_iff (h : NNReal) (hh : 0 < ↑h) (n : ℕ)
  (L : GlobalRegularization.C1History h (Fin n → ℝ) →L[ℝ] Fin n → ℝ) (A : (Fin n → ℝ) →L[ℝ] Fin n → ℝ)
  (μ ν : Fin n → Fin n → MeasureTheory.Measure ↑(GlobalRegularization.HistoryInterval h))
  [∀ (i j : Fin n), MeasureTheory.IsFiniteMeasure (μ i j)] [∀ (i j : Fin n), MeasureTheory.IsFiniteMeasure (ν i j)]
  (hrep :
    ∀ (x : GlobalRegularization.C1History h (Fin n → ℝ)) (i : Fin n),
      L x i =
        A (((GlobalRegularization.historyInclusion h (Fin n → ℝ)) x) (GlobalRegularization.historyLeft h)) i +
          ∑ j,
            (∫ (t : ↑(GlobalRegularization.HistoryInterval h)),
                ((GlobalRegularization.historyDerivative h (Fin n → ℝ)) x) t j ∂μ i j -
              ∫ (t : ↑(GlobalRegularization.HistoryInterval h)),
                ((GlobalRegularization.historyDerivative h (Fin n → ℝ)) x) t j ∂ν i j))
  (δ : ℕ → ℝ) (hδ : ∀ (m : ℕ), 0 < δ m) (hlim : Filter.Tendsto δ Filter.atTop (nhds 0)) :
  Filter.Tendsto (fun m => L.comp (GlobalRegularization.terminalCorrection h (Fin n → ℝ) (δ m) ⋯)) Filter.atTop
      (nhds 0) ↔
    ∀ (i j : Fin n),
      (μ i j).real {GlobalRegularization.historyRight h} - (ν i j).real {GlobalRegularization.historyRight h} = 0
GlobalRegularization.exists_adapted_operators_for_separable_family (h : NNReal) (hh : 0 < ↑h) (n : ℕ)
  (S : Set (GlobalRegularization.C1History h (Fin n → ℝ) →L[ℝ] Fin n → ℝ)) (hsep : TopologicalSpace.IsSeparable S)
  (hzero :
    ∀ L ∈ S,
      Filter.Tendsto
        (fun m =>
          L.comp
            (GlobalRegularization.terminalCorrection h (Fin n → ℝ) (GlobalRegularization.adaptedTerminalWidth h m) ⋯))
        Filter.atTop (nhds 0)) :
  ∃ P C,
    0 < C ∧
      (∀ (m : ℕ), ‖P m‖ ≤ C) ∧
        (∀ (x : GlobalRegularization.C1History h (Fin n → ℝ)),
            Filter.Tendsto (fun m => (P m) x) Filter.atTop (nhds x)) ∧
          (∀ (m : ℕ), FiniteDimensional ℝ ↥(LinearMap.range (P m))) ∧
            (∀ L ∈ S,
                Filter.Tendsto
                  (fun m => L.comp (P m - ContinuousLinearMap.id ℝ (GlobalRegularization.C1History h (Fin n → ℝ))))
                  Filter.atTop (nhds 0)) ∧
              ∀ (m : ℕ) (δ : ℝ) (hδ : 0 < δ),
                δ / 2 < GlobalRegularization.adaptedTerminalWidth h m →
                  (P m).comp (GlobalRegularization.terminalCorrection h (Fin n → ℝ) δ hδ) = 0
