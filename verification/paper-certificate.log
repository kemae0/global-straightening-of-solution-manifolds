GlobalRegularization.terminalHistoryCutoff_signed_variation_bound (h : NNReal)
  (s : MeasureTheory.SignedMeasure ↑(GlobalRegularization.HistoryInterval h)) (σ : ℝ) (hσh : σ ≤ ↑h) :
  GlobalRegularization.signedVariationNorm
      (GlobalRegularization.signedMeasureAdjoint (GlobalRegularization.terminalHistoryCutoff h ℝ σ hσh) s - s) ≤
    2 * s.totalVariation.real {t | -σ < ↑t}
