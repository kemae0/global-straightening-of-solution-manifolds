GlobalRegularization.C1Straightening.fiber_parameter_derivative.{u_1, u_2} {E : Type u_1} {B : Type u_2}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup B] [NormedSpace ℝ B] {U : Set E} {D : E →L[ℝ] B}
  {f : E → B} (s : GlobalRegularization.C1Straightening U D f) {x : E} (hx : x ∈ U) :
  HasFDerivAt (fun z => s.backward (s.forward x + ↑z)) (s.fiberTangentInclusion x) 0
GlobalRegularization.C1Straightening.fiberTangent_range.{u_1, u_2} {E : Type u_1} {B : Type u_2} [NormedAddCommGroup E]
  [NormedSpace ℝ E] [NormedAddCommGroup B] [NormedSpace ℝ B] {U : Set E} {D : E →L[ℝ] B} {f : E → B}
  (s : GlobalRegularization.C1Straightening U D f) (hU : IsOpen U) {x : E} (hx : x ∈ U) :
  LinearMap.range (s.fiberTangentInclusion x) = LinearMap.ker (fderiv ℝ (fun y => D y - f y) x)
GlobalRegularization.C1Straightening.continuous_complement_family.{u_1, u_2} {E : Type u_1} {B : Type u_2}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup B] [NormedSpace ℝ B] {U : Set E} {D : E →L[ℝ] B}
  {f : E → B} (s : GlobalRegularization.C1Straightening U D f) (hU : IsOpen U) (Q : B →L[ℝ] E)
  (hQ : D.comp Q = ContinuousLinearMap.id ℝ B) :
  ContinuousOn (s.defectRightInverse Q) U ∧
    ∀ x ∈ U, IsCompl (LinearMap.ker (fderiv ℝ (fun y => D y - f y) x)) (LinearMap.range (s.defectRightInverse Q x))
GlobalRegularization.C1Straightening.normal_dimension.{u_1, u_2} {E : Type u_1} {B : Type u_2} [NormedAddCommGroup E]
  [NormedSpace ℝ E] [NormedAddCommGroup B] [NormedSpace ℝ B] {U : Set E} {D : E →L[ℝ] B} {f : E → B}
  (s : GlobalRegularization.C1Straightening U D f) [FiniteDimensional ℝ B] (hU : IsOpen U) (Q : B →L[ℝ] E)
  (hQ : D.comp Q = ContinuousLinearMap.id ℝ B) {x : E} (hx : x ∈ U) :
  Module.finrank ℝ ↥(LinearMap.range (s.defectRightInverse Q x)) = Module.finrank ℝ B ∧
    Module.finrank ℝ (E ⧸ LinearMap.ker (fderiv ℝ (fun y => D y - f y) x)) = Module.finrank ℝ B
